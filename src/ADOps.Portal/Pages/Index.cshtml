@page
@model ADOps.Portal.Pages.IndexModel

@{
    ViewData["Title"] = "Investigation Dashboard";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="text-muted text-uppercase small fw-semibold">
                ADOps AI
            </div>

            <h1 class="display-6 fw-bold mb-1">
                Active Directory Investigation
            </h1>

            @if (Model.Report is not null)
            {
                <div class="text-muted">
                    @Model.Report.IncidentNumber
                </div>
            }
        </div>

        @if (Model.Report is not null)
        {
            <div class="mt-3 mt-md-0 text-md-end">
                <div class="text-muted small">
                    Overall Confidence
                </div>

                <div class="display-6 fw-bold">
                    @Model.Report.OverallConfidence.ToString("P0")
                </div>
            </div>
        }
    </div>

    @if (Model.Report is null)
    {
        <div class="alert alert-warning">
            No investigation report is currently available.
        </div>
    }
    else
    {
        <!-- Executive Summary -->
        <section class="mb-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="h4 mb-1">
                                Executive Summary
                            </h2>

                            <div class="text-muted small">
                                Investigation @Model.Report.InvestigationId
                            </div>
                        </div>

                        <span class="badge text-bg-danger">
                            Critical
                        </span>
                    </div>

                    <p class="lead mb-4">
                        @Model.Report.ExecutiveSummary.Summary
                    </p>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <h3 class="h6 text-uppercase text-muted">
                                Business Impact
                            </h3>

                            <p class="mb-0">
                                @Model.Report.ExecutiveSummary.BusinessImpact
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h3 class="h6 text-uppercase text-muted">
                                Technical Impact
                            </h3>

                            <p class="mb-0">
                                @Model.Report.ExecutiveSummary.TechnicalImpact
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Root Cause -->
        <section class="mb-4">
            <div class="card shadow-sm border-warning">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">
                        <h2 class="h4 mb-0">
                            Root Cause
                        </h2>
                    </div>

                    <p class="mb-0 fs-5">
                        @Model.Report.RootCause
                    </p>

                </div>
            </div>
        </section>

        <!-- Correlations -->
        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">
                        Correlated Findings
                    </h2>

                    <div class="text-muted small">
                        Evidence-backed relationships identified during investigation
                    </div>
                </div>

                <span class="badge text-bg-secondary">
                    @Model.Report.Correlations.Count findings
                </span>
            </div>

            <div class="row g-3">
                @foreach (var correlation in Model.Report.Correlations)
                {
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                    <h3 class="h5 mb-0">
                                        @correlation.Type
                                    </h3>

                                    <span class="badge text-bg-primary">
                                        @correlation.Confidence.ToString("P0")
                                    </span>
                                </div>

                                <p class="mb-3">
                                    @correlation.Summary
                                </p>

                                <div class="small text-muted">
                                    <strong>Evidence:</strong>
                                    @string.Join(", ", correlation.EvidenceIds)
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Recommendations -->
        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">
                        Recommended Actions
                    </h2>

                    <div class="text-muted small">
                        Corrective and preventive actions generated from the investigation
                    </div>
                </div>

                <span class="badge text-bg-secondary">
                    @Model.Report.Recommendations.Count actions
                </span>
            </div>

            <div class="card shadow-sm">
                <div class="list-group list-group-flush">

                    @foreach (var recommendation in Model.Report.Recommendations)
                    {
                        <div class="list-group-item p-3">

                            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                                <div>
                                    <div class="fw-semibold">
                                        @recommendation.Action
                                    </div>

                                    <div class="text-muted small mt-1">
                                        @recommendation.Reason
                                    </div>
                                </div>

                                <div>
                                    <span class="badge text-bg-secondary">
                                        @recommendation.Priority
                                    </span>
                                </div>
                            </div>

                        </div>
                    }

                </div>
            </div>
        </section>

        <!-- Evidence -->
        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h4 mb-1">
                        Evidence
                    </h2>

                    <div class="text-muted small">
                        Source evidence supporting the investigation findings
                    </div>
                </div>

                <span class="badge text-bg-secondary">
                    @Model.Report.Evidence.Count items
                </span>
            </div>

            <div class="card shadow-sm">
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th scope="col">Evidence</th>
                                <th scope="col">Type</th>
                                <th scope="col">Source</th>
                                <th scope="col">Target</th>
                                <th scope="col">Summary</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var evidence in Model.Report.Evidence)
                            {
                                <tr>
                                    <td>
                                        <code>@evidence.EvidenceId</code>
                                    </td>

                                    <td>
                                        @evidence.Type
                                    </td>

                                    <td>
                                        @evidence.Source
                                    </td>

                                    <td>
                                        @evidence.Target
                                    </td>

                                    <td>
                                        @evidence.Summary
                                    </td>

                                    <td>
                                        @if (evidence.IsValid)
                                        {
                                            <span class="badge text-bg-success">
                                                Valid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger">
                                                Invalid
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            </div>
        </section>

        <!-- Footer metadata -->
        <div class="text-muted small border-top pt-3">
            Report generated
            @Model.Report.GeneratedUtc.ToLocalTime().ToString("g")
        </div>
    }

</div>