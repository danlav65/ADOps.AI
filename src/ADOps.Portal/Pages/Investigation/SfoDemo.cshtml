@page
@model ADOps.Portal.Pages.Investigation.SfoDemoModel

@{
    ViewData["Title"] = "SFO P1 Incident";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="text-muted text-uppercase small fw-semibold">
                ADOps AI · Management Demo
            </div>

            <h1 class="display-6 fw-bold mb-1">
                SFO P1 Incident
            </h1>

            <div class="text-muted">
                @Model.Demo.IncidentNumber · @Model.Demo.Domain
            </div>
        </div>

        <div class="mt-3 mt-md-0">
            <span class="badge text-bg-danger fs-6">
                @Model.Demo.Severity
            </span>
        </div>
    </div>

    <div class="alert alert-light border shadow-sm mb-4">
        <div class="fw-semibold mb-1">
            Active Directory investigation
        </div>

        <div class="text-muted">
            ADOps AI is analyzing the SFO Active Directory incident using
            normalized evidence collected from the affected environment.
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    Incident
                </div>

                <div class="card-body">
                    <dl class="row mb-0">

                        <dt class="col-sm-4">Incident</dt>
                        <dd class="col-sm-8">
                            @Model.Demo.IncidentNumber
                        </dd>

                        <dt class="col-sm-4">Site</dt>
                        <dd class="col-sm-8">
                            @Model.Demo.Site
                        </dd>

                        <dt class="col-sm-4">Environment</dt>
                        <dd class="col-sm-8">
                            @Model.Demo.Environment
                        </dd>

                        <dt class="col-sm-4">Detected</dt>
                        <dd class="col-sm-8">
                            @Model.Demo.DetectedUtc
                        </dd>

                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    Business Impact
                </div>

                <div class="card-body">
                    <p class="mb-0">
                        @Model.Demo.BusinessImpact
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    Technical Impact
                </div>

                <div class="card-body">
                    <p class="mb-0">
                        @Model.Demo.TechnicalImpact
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    Affected Domain Controllers
                </div>

                <div class="card-body">
                    <ul class="mb-0">
                        @foreach (var controller in Model.Demo.AffectedDomainControllers)
                        {
                            <li>
                                <code>@controller</code>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            Key Investigation Signals
        </div>

        <div class="card-body">
            <div class="row">

                @foreach (var symptom in Model.Demo.KeySymptoms)
                {
                    <div class="col-md-6 col-lg-3 mb-3 mb-lg-0">
                        <div class="border rounded p-3 h-100">
                            @symptom
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            Investigation Workflow
        </div>

        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">

                <a asp-page="/"
                   class="btn btn-primary">
                    View Investigation Dashboard
                </a>

                <a asp-page="/Investigation/Details"
                   class="btn btn-outline-primary">
                    View Investigation Detail
                </a>

                <a asp-page="/Investigation/Evidence"
                   class="btn btn-outline-primary">
                    Explore Evidence
                </a>

            </div>

        </div>
    </div>

</div>