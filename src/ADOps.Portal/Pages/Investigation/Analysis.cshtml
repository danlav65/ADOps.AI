@page
@model ADOps.Portal.Pages.Investigation.AnalysisModel

@{
    ViewData["Title"] = "Investigation Analysis";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="text-muted text-uppercase small fw-semibold">
                ADOps AI · Investigation Analysis
            </div>

            <h1 class="display-6 fw-bold mb-1">
                Investigation Analysis
            </h1>

            @if (Model.Report is not null)
            {
                <div class="text-muted">
                    @Model.Report.IncidentNumber
                </div>
            }
        </div>
    </div>

    @if (Model.Report is null)
    {
        <div class="alert alert-warning">
            Investigation analysis is not available.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                Executive Summary
            </div>

            <div class="card-body">
                <p class="lead">
                    @Model.Report.ExecutiveSummary.Summary
                </p>

                <div class="row g-4 mt-1">

                    <div class="col-lg-6">
                        <h5>Business Impact</h5>
                        <p class="mb-0">
                            @Model.Report.ExecutiveSummary.BusinessImpact
                        </p>
                    </div>

                    <div class="col-lg-6">
                        <h5>Technical Impact</h5>
                        <p class="mb-0">
                            @Model.Report.ExecutiveSummary.TechnicalImpact
                        </p>
                    </div>

                </div>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        Root Cause
                    </div>

                    <div class="card-body">
                        <p class="mb-0">
                            @Model.Report.RootCause
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        Overall Confidence
                    </div>

                    <div class="card-body">
                        <div class="display-6 fw-semibold">
                            @Model.Report.OverallConfidence.ToString("P0")
                        </div>

                        <div class="text-muted">
                            Analysis confidence
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }

</div>