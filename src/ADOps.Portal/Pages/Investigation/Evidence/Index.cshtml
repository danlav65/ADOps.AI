@page
@model ADOps.Portal.Pages.Investigation.Evidence.IndexModel

@{
    ViewData["Title"] = "Evidence Explorer";
}

<div class="container-fluid py-4">

    @if (Model.Report is null)
    {
        <div class="alert alert-warning">
            No investigation evidence is currently available.
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <div class="text-muted text-uppercase small fw-semibold">
                    ADOps AI
                </div>

                <h1 class="display-6 fw-bold mb-1">
                    Evidence Explorer
                </h1>

                <div class="text-muted">
                    Investigation @Model.Report.IncidentNumber
                </div>
            </div>

            <div class="mt-3 mt-md-0">
                <a asp-page="/Investigation/Details"
                   class="btn btn-outline-primary">
                    Investigation Detail
                </a>

                <a asp-page="/"
                   class="btn btn-outline-secondary ms-2">
                    Dashboard
                </a>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 mb-1">
                    Investigation Evidence
                </h2>

                <div class="text-muted small">
                    Normalized evidence supporting the investigation findings
                </div>
            </div>

            <span class="badge text-bg-secondary">
                @Model.Report.Evidence.Count items
            </span>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th scope="col">Evidence</th>
                            <th scope="col">Type</th>
                            <th scope="col">Source</th>
                            <th scope="col">Target</th>
                            <th scope="col">Collected</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var evidence in Model.Report.Evidence)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Investigation/Evidence/Details"
                                        asp-route-id="@evidence.EvidenceId"
                                        class="text-decoration-none">
                                            <code>@evidence.EvidenceId</code>
                                    </a>
                                </td>

                                <td>
                                    @evidence.Type
                                </td>

                                <td>
                                    @evidence.Source
                                </td>

                                <td>
                                    @evidence.Target
                                </td>

                                <td>
                                    @evidence.CollectedUtc
                                </td>

                                <td>
                                    @if (evidence.IsValid)
                                    {
                                        <span class="badge text-bg-success">
                                            Valid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">
                                            Invalid
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }
</div>